unit frLoginOverlay;

interface

uses
  System.SysUtils, System.Classes, System.UITypes,
  Vcl.Controls, Vcl.ExtCtrls, Vcl.StdCtrls, Vcl.Forms, Vcl.Imaging.pngimage, dmImageResources,
  Vcl.Buttons, Vcl.Touch.Keyboard,uTranslator,dmUIActions;

type
  TFrameLoginOverlay = class(TFrame)
    PanelMask: TPanel;
    PanelCard: TPanel;
    cboEmpresa: TComboBox;
    cboUsuario: TComboBox;
    edtPass: TEdit;
    Image1: TImage;
    btnAceptar: TButton;
    btnCerrar: TButton;
    Panel1: TPanel;
    cboidioma: TComboBox;
    labelselecidioma: TLabel;
  private
    procedure WireTabOrder;
  public
    constructor Create(AOwner: TComponent); override;
    procedure CenterCard;
    procedure FrameResize(Sender: TObject);
    procedure AfterConstruction; override;
  end;

implementation

{$R *.dfm}

{ TFrameLoginOverlay }

constructor TFrameLoginOverlay.Create(AOwner: TComponent);
begin
  inherited;

  btnAceptar.Default := True;  // Enter = Click en Entrar
  btnCerrar.Cancel   := True;  // Esc   = Click en Salir

   // Recentrar automáticamente cuando cambie el tamaño
  OnResize := FrameResize;

end;

procedure TFrameLoginOverlay.AfterConstruction;
begin
  inherited;
 // CenterCard;
  //Asignar iconos corporativos
   // Asigna iconos (usa VirtualImageList)
//  StyleIconButtonByName(btnAceptar, dmImages.VirtualImageList1,
//    'loginico', dmImages.GetIconIndex, True, False, 6);
end;

procedure TFrameLoginOverlay.WireTabOrder;
begin
  cboEmpresa.TabOrder := 0;
  cboUsuario.TabOrder := 1;
  edtPass.TabOrder    := 2;
  btnAceptar.TabOrder := 3;
  btnCerrar.TabOrder  := 4;
end;

procedure TFrameLoginOverlay.FrameResize(Sender: TObject);
begin
  CenterCard;
end;

procedure TFrameLoginOverlay.CenterCard;
begin
  if Assigned(PanelCard) and Assigned(PanelMask) then
  begin
    PanelCard.Left := (PanelMask.ClientWidth  - PanelCard.Width)  div 2;
    PanelCard.Top  := (PanelMask.ClientHeight - PanelCard.Height) div 2;
  end;
end;

end.
