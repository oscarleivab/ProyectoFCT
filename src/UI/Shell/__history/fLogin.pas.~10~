unit fLogin;

interface

uses
  Winapi.Windows, Winapi.Messages,
  System.SysUtils, System.Classes, System.Types,
  Vcl.Graphics, Vcl.Controls, Vcl.Forms, Vcl.Dialogs, Vcl.StdCtrls, Vcl.ExtCtrls,
  FireDAC.Comp.Client, FireDAC.Stan.Param,
  dmConnection, uSession;

type
  TFrmLogin = class(TForm)
    Panelbase: TPanel;
    Paneliniciosesion: TPanel;
    labelerroruser: TLabel;
    botoniniciarsesion: TButton;
    Passedit: TEdit;
    conexionbtn: TButton;
    botonCerrarApp: TButton;
    empresabox: TComboBox;
    cbxuser: TComboBox;
    procedure FormCreate(Sender: TObject);
    procedure botoniniciarsesionClick(Sender: TObject);
    procedure botonCerrarAppClick(Sender: TObject);
    procedure conexionbtnClick(Sender: TObject);
    procedure empresaboxChange(Sender: TObject);
    procedure PasseditKeyPress(Sender: TObject; var Key: Char);
  private
    procedure LoadCompanies;
    procedure LoadUsersForSelectedCompany;
    function ValidateLogin: Boolean;
    function ItemDataAsInteger(ACombo: TComboBox): Integer;
  public
  end;

var
  FrmLogin: TFrmLogin;

implementation

{$R *.dfm}

uses
  fMain;

{ Utils }

function TFrmLogin.ItemDataAsInteger(ACombo: TComboBox): Integer;
begin
  if (ACombo.ItemIndex < 0) or (ACombo.ItemIndex >= ACombo.Items.Count) then
    Exit(0);
  // Guardamos IDs en Items.Objects. Convertimos NativeInt<->TObject con seguridad 32/64 bits.
  Result := Integer(NativeInt(ACombo.Items.Objects[ACombo.ItemIndex]));
end;

{ Lifecycle }

procedure TFrmLogin.FormCreate(Sender: TObject);
begin
  labelerroruser.Visible := False;

  // Garantiza conexión a base principal (lee INI y fija DLL)
  DataModuleConnection.ConnectToMainDatabase;

  // Carga empresas
  LoadCompanies;

  if empresabox.Items.Count > 0 then
  begin
    empresabox.ItemIndex := 0;
    LoadUsersForSelectedCompany;
    if cbxuser.Items.Count > 0 then
      cbxuser.ItemIndex := 0;
  end;

  // UX: foco
  if cbxuser.CanFocus then
    cbxuser.SetFocus;
end;

{ Data loading }

procedure TFrmLogin.LoadCompanies;
var
  Q: TFDQuery;
begin
  empresabox.Clear;

  Q := TFDQuery.Create(nil);
  try
    Q.Connection := DataModuleConnection.FDConnectionMain;
    // ⚠️ Ajusta a tu esquema real
    Q.SQL.Text :=
      'SELECT id, nombre ' +
      'FROM empresas ' +
      'WHERE activo = TRUE ' +
      'ORDER BY nombre';
    Q.Open;
    while not Q.Eof do
    begin
      // Guardamos el ID en Objects
      empresabox.Items.AddObject(
        Q.FieldByName('nombre').AsString,
        TObject(NativeInt(Q.FieldByName('id').AsInteger))
      );
      Q.Next;
    end;
  finally
    Q.Free;
  end;
end;

procedure TFrmLogin.LoadUsersForSelectedCompany;
var
  Q: TFDQuery;
  CompanyId: Integer;
begin
  cbxuser.Clear;
  Passedit.Clear;

  CompanyId := ItemDataAsInteger(empresabox);
  if CompanyId = 0 then Exit;

  Q := TFDQuery.Create(nil);
  try
    Q.Connection := DataModuleConnection.FDConnectionMain;
    // ⚠️ Ajusta a tu esquema real
    Q.SQL.Text :=
      'SELECT id, username ' +
      'FROM usuarios ' +
      'WHERE activo = TRUE AND empresa_id = :eid ' +
      'ORDER BY username';
    Q.ParamByName('eid').AsInteger := CompanyId;
    Q.Open;
    while not Q.Eof do
    begin
      cbxuser.Items.AddObject(
        Q.FieldByName('username').AsString,
        TObject(NativeInt(Q.FieldByName('id').AsInteger))
      );
      Q.Next;
    end;
  finally
    Q.Free;
  end;
end;

{ Events }

procedure TFrmLogin.empresaboxChange(Sender: TObject);
begin
  LoadUsersForSelectedCompany;
  if cbxuser.Items.Count > 0 then
    cbxuser.ItemIndex := 0;
end;

procedure TFrmLogin.PasseditKeyPress(Sender: TObject; var Key: Char);
begin
  if Key = #13 then
  begin
    Key := #0;
    botoniniciarsesionClick(Sender);
  end;
end;

procedure TFrmLogin.botonCerrarAppClick(Sender: TObject);
begin
  Close; // El DPR/OnClose de Login puede terminar la app si no hay sesión.
end;

procedure TFrmLogin.conexionbtnClick(Sender: TObject);
var
  Q: TFDQuery;
begin
  // Pequeño ping para mostrar estado de conexión a base principal
  Q := TFDQuery.Create(nil);
  try
    Q.Connection := DataModuleConnection.FDConnectionMain;
    Q.SQL.Text := 'select 1';
    Q.Open;
    MessageDlg('Conexión OK con la base principal.', mtInformation, [mbOK], 0);
  except
    on E: Exception do
      MessageDlg('Error de conexión: ' + E.Message, mtError, [mbOK], 0);
  end;
  Q.Free;
end;

procedure TFrmLogin.botoniniciarsesionClick(Sender: TObject);
begin
  labelerroruser.Visible := False;

  if not ValidateLogin then
  begin
    labelerroruser.Visible := True;
    Exit;
  end;

  // Abrir Main
  if not Assigned(FrmMain) then
    Application.CreateForm(TFrmMain, FrmMain);

  // Si tienes un método para refrescar status bar con Session:
  // FrmMain.UpdateStatusBar(Session.UserName, Session.CompanyName);

  Hide;
  FrmMain.Show;
end;

{ Auth }

function TFrmLogin.ValidateLogin: Boolean;
var
  Q: TFDQuery;
  CompanyId, UserId: Integer;
  CompanyName, UserName, PasswordInput, PasswordDB: string;
begin
  Result := False;

  if (empresabox.ItemIndex < 0) or (cbxuser.ItemIndex < 0) then
    Exit;

  CompanyId   := ItemDataAsInteger(empresabox);
  CompanyName := empresabox.Items[empresabox.ItemIndex];
  UserId      := ItemDataAsInteger(cbxuser);
  UserName    := cbxuser.Items[cbxuser.ItemIndex];
  PasswordInput := Passedit.Text;

  if (CompanyId = 0) or (UserId = 0) then Exit;

  Q := TFDQuery.Create(nil);
  try
    Q.Connection := DataModuleConnection.FDConnectionMain;

    // ⚠️ Por ahora texto plano; en el próximo paso migramos a hash seguro
    Q.SQL.Text :=
      'SELECT password ' +
      'FROM usuarios ' +
      'WHERE id = :uid AND empresa_id = :eid AND activo = TRUE';
    Q.ParamByName('uid').AsInteger := UserId;
    Q.ParamByName('eid').AsInteger := CompanyId;
    Q.Open;

    if Q.IsEmpty then Exit;

    PasswordDB := Q.Fields[0].AsString;

    if not SameText(PasswordInput, PasswordDB) then
      Exit;

    // Sesión global
    // Guardar sesión tras validar
    AppSession.CompanyId   := CompanyId;
    AppSession.CompanyName := CompanyName;
    AppSession.UserId      := UserId;
    AppSession.UserName    := UserName;

    Result := True;
  finally
    Q.Free;
  end;
end;

end.

