procedure TListadoEntidadFrame.OnCargarlistado;
var
SQL:String;
SQLFilter:String;
begin

 SQL:=Entidad_Listado;
 SQLFilter:=Entidad_Filtrado;

  if ComprobarConexion then
  begin

    if not Assigned(Trcons) then
    Trcons:=CrearTransaccion;

    if not Assigned(Cons) then
    Cons:=CrearQuery(Trcons);


        try
           Cons.SQL.Clear;
           Cons.SQL.Add(SQL);

           if activocheck.State=tssOn then
             Cons.ParamByName('pactivo').AsBoolean:=true
             else
             Cons.ParamByName('pactivo').AsBoolean:=false;

           Cons.ParamByName('ptipoentidad').AsInteger:=TipoEntidad;

           if buscaedit.Text<>'' then
           begin
             Cons.SQL.Add(SQLFilter);
             Cons.ParamByName('pdocumento').AsString:='%'+UpperCase(buscaedit.Text)+'%';
             Cons.ParamByName('pnombre').AsString:='%'+UpperCase(buscaedit.Text)+'%';
             Cons.ParamByName('papellidos').AsString:='%'+UpperCase(buscaedit.Text)+'%';
             Cons.ParamByName('pempresa').AsString:='%'+UpperCase(buscaedit.Text)+'%';
             Cons.ParamByName('ptelefono1').AsString:='%'+buscaedit.Text+'%';
             Cons.ParamByName('ptelefono2').AsString:='%'+buscaedit.Text+'%';
             Cons.ParamByName('pemail').AsString:='%'+UpperCase(buscaedit.Text)+'%';
           end;

           Cons.SQL.Add(' order by "id_entidad" desc');
           Cons.Open();
           TraducirTexto();
           CargarDatosEnGrid(Cons,Listadogrid);
           AjustarAnchoColumnas(Listadogrid);
           OcultarColumnas(Listadogrid, [0,1,2]); // Oculta las columnas 1 y 2


        Except
          on E:Exception do
          begin
          ShowMessage(e.Message);
          end;
        end;
  end;

end;

