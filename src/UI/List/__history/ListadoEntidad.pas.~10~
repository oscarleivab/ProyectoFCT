procedure TListadoEntidadFrame.Traducirfield;
begin

  if assigned(Cons) then begin
    with Cons do
    begin
      FieldByName('nombre').DisplayLabel       := T_('ListadoEntidad','labelNombre');
      FieldByName('apellidos').DisplayLabel    := T_('ListadoEntidad','labelApellidos');
      FieldByName('empresa').DisplayLabel      := T_('ListadoEntidad','labelEmpresa');
      FieldByName('email').DisplayLabel        := T_('ListadoEntidad','labelEmail');
      FieldByName('observaciones').DisplayLabel:= T_('ListadoEntidad','labelObservaciones');
      FieldByName('telefono1').DisplayLabel       := T_('ListadoEntidad','labelTelefono1');
      FieldByName('telefono2').DisplayLabel       := T_('ListadoEntidad','labelTelefono2');
      FieldByName('id_tarifa').DisplayLabel    := T_('ListadoEntidad','labelIdTarifa');
      FieldByName('persona_contacto').DisplayLabel      := T_('ListadoEntidad','labelPersonaContacto');
      FieldByName('url_web').DisplayLabel        := T_('ListadoEntidad','labelUrlWeb');
      FieldByName('user_login').DisplayLabel:= T_('ListadoEntidad','labelUserLogin');
      FieldByName('pass_login').DisplayLabel       := T_('ListadoEntidad','labelPassLogin');
      FieldByName('activo').DisplayLabel    := T_('ListadoEntidad','labelActivo');
      FieldByName('id_permiso').DisplayLabel        := T_('ListadoEntidad','labelIdPermiso');
    end;
  end;


end;

