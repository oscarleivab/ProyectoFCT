interface

uses
  Winapi.Windows, Winapi.Messages, System.SysUtils, System.Variants, System.Classes, Vcl.Graphics,
  Vcl.Controls, Vcl.Forms, Vcl.Dialogs, Vcl.StdCtrls, Vcl.WinXPickers,
  FireDAC.Stan.Intf, FireDAC.Stan.Option, FireDAC.Stan.Error, FireDAC.UI.Intf,
  FireDAC.Phys.Intf, FireDAC.Stan.Def, FireDAC.Stan.Pool, FireDAC.Stan.Async,
  FireDAC.Phys, FireDAC.Phys.PG, FireDAC.Phys.PGDef, FireDAC.VCLUI.Wait,
  Data.DB, FireDAC.Comp.Client, FireDAC.Phys.IBDef, FireDAC.Phys.IBBase,
  FireDAC.Phys.IB, FireDAC.Stan.Param, FireDAC.DatS,
  FireDAC.DApt.Intf, FireDAC.DApt, FireDAC.Comp.DataSet, Vcl.Grids, Vcl.ExtCtrls,
  Vcl.Buttons, Datasnap.Provider, Datasnap.DBClient, Vcl.DBGrids,Vcl.DBCtrls, Vcl.ComCtrls, Vcl.Mask,System.Hash,
  System.Generics.Collections,
  uClienteModel,uTranslator;

procedure CargarClientesEnStringGrid(AGrid: TStringGrid; AClientes: TObjectList<TCliente>);
procedure AjustarAnchoColumnas(Grid: TStringGrid);
procedure OcultarColumnas(Grid: TStringGrid; Columnas: array of Integer);

implementation

procedure CargarClientesEnStringGrid(AGrid: TStringGrid; AClientes: TObjectList<TCliente>);
var
  i, Row, DataCount: Integer;
  C: TCliente;
begin
  AGrid.ColCount := 18;

  if AClientes <> nil then
    DataCount := AClientes.Count
  else
    DataCount := 0;

  if DataCount = 0 then
  begin
    // Sin datos: 1 cabecera + 1 fila vacía
    AGrid.RowCount  := 2;  // filas: 0 y 1
    AGrid.FixedRows := 1;  // fila 0 = cabecera

    // Cabeceras
    AGrid.Cells[0,  0] := T_('Clientes', 'id_cliente');
    AGrid.Cells[1,  0] := T_('Clientes', 'id_tipo');
    AGrid.Cells[2,  0] := T_('Clientes', 'id_tipo_documento');
    AGrid.Cells[3,  0] := T_('Clientes', 'detalle_documento');
    AGrid.Cells[4,  0] := T_('Clientes', 'nombre');
    AGrid.Cells[5,  0] := T_('Clientes', 'apellidos');
    AGrid.Cells[6,  0] := T_('Clientes', 'empresa');
    AGrid.Cells[7,  0] := T_('Clientes', 'email');
    AGrid.Cells[8,  0] := T_('Clientes', 'observaciones');
    AGrid.Cells[9,  0] := T_('Clientes', 'telefono1');
    AGrid.Cells[10, 0] := T_('Clientes', 'telefono2');
    AGrid.Cells[11, 0] := T_('Clientes', 'id_tarifa');
    AGrid.Cells[12, 0] := T_('Clientes', 'persona_contacto');
    AGrid.Cells[13, 0] := T_('Clientes', 'url_web');
    AGrid.Cells[14, 0] := T_('Clientes', 'user_login');
    AGrid.Cells[15, 0] := T_('Clientes', 'pass_login');
    AGrid.Cells[16, 0] := T_('Clientes', 'activo');
    AGrid.Cells[17, 0] := T_('Clientes', 'id_permiso');

    // Limpiamos la fila de datos (fila 1) por si venían restos de antes
    AGrid.Rows[1].Clear;

    Exit;
  end;

  // Con datos: 1 cabecera + N filas de datos
  AGrid.RowCount  := DataCount + 1; // fila 0 = cabecera
  AGrid.FixedRows := 1;

  // Cabeceras
  AGrid.Cells[0,  0] := T_('Clientes', 'id_cliente');
  AGrid.Cells[1,  0] := T_('Clientes', 'id_tipo');
  AGrid.Cells[2,  0] := T_('Clientes', 'id_tipo_documento');
  AGrid.Cells[3,  0] := T_('Clientes', 'detalle_documento');
  AGrid.Cells[4,  0] := T_('Clientes', 'nombre');
  AGrid.Cells[5,  0] := T_('Clientes', 'apellidos');
  AGrid.Cells[6,  0] := T_('Clientes', 'empresa');
  AGrid.Cells[7,  0] := T_('Clientes', 'email');
  AGrid.Cells[8,  0] := T_('Clientes', 'observaciones');
  AGrid.Cells[9,  0] := T_('Clientes', 'telefono1');
  AGrid.Cells[10, 0] := T_('Clientes', 'telefono2');
  AGrid.Cells[11, 0] := T_('Clientes', 'id_tarifa');
  AGrid.Cells[12, 0] := T_('Clientes', 'persona_contacto');
  AGrid.Cells[13, 0] := T_('Clientes', 'url_web');
  AGrid.Cells[14, 0] := T_('Clientes', 'user_login');
  AGrid.Cells[15, 0] := T_('Clientes', 'pass_login');
  AGrid.Cells[16, 0] := T_('Clientes', 'activo');
  AGrid.Cells[17, 0] := T_('Clientes', 'id_permiso');

  // Datos
  for i := 0 to DataCount - 1 do
  begin
    Row := i + 1; // porque la 0 es cabecera
    C   := AClientes[i];

    AGrid.Cells[0,  Row] := C.IdCliente.ToString;
    AGrid.Cells[1,  Row] := C.IdTipo.ToString;
    AGrid.Cells[2,  Row] := C.IdTipoDocumento.ToString;
    AGrid.Cells[3,  Row] := C.DetalleDocumento;
    AGrid.Cells[4,  Row] := C.Nombre;
    AGrid.Cells[5,  Row] := C.Apellidos;
    AGrid.Cells[6,  Row] := C.Empresa;
    AGrid.Cells[7,  Row] := C.Email;
    AGrid.Cells[8,  Row] := C.Observaciones;
    AGrid.Cells[9,  Row] := C.Telefono1;
    AGrid.Cells[10, Row] := C.Telefono2;
    AGrid.Cells[11, Row] := C.IdTarifa.ToString;
    AGrid.Cells[12, Row] := C.PersonaContacto;
    AGrid.Cells[13, Row] := C.UrlWeb;
    AGrid.Cells[14, Row] := C.UserLogin;
    AGrid.Cells[15, Row] := C.PassLogin;

    if C.Activo then
      AGrid.Cells[16, Row] := T_('Comun', 'si')
    else
      AGrid.Cells[16, Row] := T_('Comun', 'no');

    AGrid.Cells[17, Row] := C.IdPermiso.ToString;

    AjustarAnchoColumnas(AGrid);
  end;
end;


procedure AjustarAnchoColumnas(Grid: TStringGrid);
var
  Col, Row, MaxWidth: Integer;
  Texto: string;
begin
  for Col := 0 to Grid.ColCount - 1 do
  begin
    MaxWidth := Grid.Canvas.TextWidth(Grid.Cells[Col, 0]) + 10; // Ancho del encabezado
    for Row := 1 to Grid.RowCount - 1 do
    begin
      Texto := Grid.Cells[Col, Row];
      if Grid.Canvas.TextWidth(Texto) + 10 > MaxWidth then
        MaxWidth := Grid.Canvas.TextWidth(Texto) + 10;
    end;
    Grid.ColWidths[Col] := MaxWidth;
  end;
end;

procedure OcultarColumnas(Grid: TStringGrid; Columnas: array of Integer);
var
  i: Integer;
begin
  for i := Low(Columnas) to High(Columnas) do
    Grid.ColWidths[Columnas[i]] := 0;
end;

procedure CargarDatosEnGrid(Query: TFDQuery; Grid: TStringGrid);
var
  i, row: Integer;
begin
  // Configurar las columnas del StringGrid
  Grid.ColCount := Query.FieldCount;
  for i := 0 to Query.FieldCount - 1 do
    Grid.Cells[i, 0] := Uppercase(Query.Fields[i].DisplayName);

  // Configurar las filas del StringGrid
  Grid.RowCount := Query.RecordCount + 1;
  row := 1;
  Query.First;
  while not Query.Eof do
  begin
    for i := 0 to Query.FieldCount - 1 do
      Grid.Cells[i, row] := Query.Fields[i].AsString;
    Inc(row);
    Query.Next;
  end;
end;

end.
