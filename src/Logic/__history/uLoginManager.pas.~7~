unit uLoginManager;

interface

uses
  System.SysUtils, System.Classes,
  FireDAC.Comp.Client, FireDAC.Stan.Param,
  dmConnection, uSession;

type
  TLoginManager = class
  public
    class procedure LoadCompanies(ATarget: TStrings);
    class procedure ConnectCompanyAndLoadEmployees(ACompanyId: Integer; ATarget: TStrings; out ACompanyName: string);
    class function ValidateEmployee(AUserId: Integer; const APassword: string): Boolean;
  end;

implementation

{ Empresas de la BD principal }
class procedure TLoginManager.LoadCompanies(ATarget: TStrings);
var
  Q: TFDQuery;
begin
  ATarget.Clear;
  Q := TFDQuery.Create(nil);
  try
    Q.Connection := DataModuleConnection.FDConnectionMain;
    Q.SQL.Text :=
      'SELECT id, empresaname '+
      'FROM empresa '+
      'WHERE activa = TRUE '+
      'ORDER BY empresaname';
    Q.Open;
    while not Q.Eof do
    begin
      ATarget.AddObject(
        Q.FieldByName('empresaname').AsString,
        TObject(NativeInt(Q.FieldByName('id').AsInteger))
      );
      Q.Next;
    end;
  finally
    Q.Free;
  end;
end;

{ Conecta a la BD de empresa y carga empleados }
class procedure TLoginManager.ConnectCompanyAndLoadEmployees(ACompanyId: Integer; ATarget: TStrings; out ACompanyName: string);
var
  Q: TFDQuery;
begin
  ATarget.Clear;
  ACompanyName := '';

  if ACompanyId = 0 then Exit;

  // 1) Conectar a la BD de la empresa con userbd/passbd
  DataModuleConnection.ConnectToCompanyDatabase(ACompanyId, ACompanyName);

  // 2) Cargar empleados (desde la BD de la empresa)
  Q := TFDQuery.Create(nil);
  try
    Q.Connection := DataModuleConnection.FDConnectionCompany;
    Q.SQL.Text :=
      'SELECT id, username '+
      'FROM empleados '+
      'WHERE activo = TRUE '+
      'ORDER BY username';
    Q.Open;
    while not Q.Eof do
    begin
      ATarget.AddObject(
        Q.FieldByName('username').AsString,
        TObject(NativeInt(Q.FieldByName('id').AsInteger))
      );
      Q.Next;
    end;
  finally
    Q.Free;
  end;
end;

{ Validación del empleado en la BD de la empresa }
class function TLoginManager.ValidateEmployee(AUserId: Integer; const APassword: string): Boolean;
var
  Q: TFDQuery;
  PassDB, UserName: string;
begin
  Result := False;
  if (AUserId = 0) or (APassword = '') then Exit;

  Q := TFDQuery.Create(nil);
  try
    Q.Connection := DataModuleConnection.FDConnectionCompany;
    Q.SQL.Text :=
      'SELECT username, password '+
      'FROM empleados '+
      'WHERE id = :uid AND activo = TRUE';
    Q.ParamByName('uid').AsInteger := AUserId;
    Q.Open;

    if Q.IsEmpty then Exit;

    UserName := Q.FieldByName('username').AsString;
    PassDB   := Q.FieldByName('password').AsString;

    // TODO: migrar a hash (bcrypt/argon2). Por ahora: texto plano.
    if SameText(APassword, PassDB) then
    begin
      AppSession.UserId   := AUserId;
      AppSession.UserName := UserName;
      Result := True;
    end;
  finally
    Q.Free;
  end;
end;

end.
