unit uLoginManager;

interface

uses
  System.SysUtils, System.Classes,
  FireDAC.Comp.Client, FireDAC.Stan.Param,
  dmConnection, uSession;

type
  TLoginManager = class
  public
    class procedure LoadCompanies(ATarget: TStrings);
    class procedure LoadUsers(ACompanyId: Integer; ATarget: TStrings);
    class function ValidateLogin(ACompanyId, AUserId: Integer; const APassword: string): Boolean;
  end;

implementation

{ TLoginManager }

class procedure TLoginManager.LoadCompanies(ATarget: TStrings);
var
  Q: TFDQuery;
begin
  ATarget.Clear;

  Q := TFDQuery.Create(nil);
  try
    Q.Connection := DataModuleConnection.FDConnectionMain;
    Q.SQL.Text :=
      'SELECT id, empresaname ' +
      'FROM empresa ' +
      'WHERE activa = TRUE ' +
      'ORDER BY empresaname';
    Q.Open;

    while not Q.Eof do
    begin
      ATarget.AddObject(
        Q.FieldByName('empresaname').AsString,
        TObject(NativeInt(Q.FieldByName('id').AsInteger))
      );
      Q.Next;
    end;
  finally
    Q.Free;
  end;
end;

class procedure TLoginManager.LoadUsers(ACompanyId: Integer; ATarget: TStrings);
var
  Q: TFDQuery;
begin
  ATarget.Clear;
  if ACompanyId = 0 then
    Exit;

  Q := TFDQuery.Create(nil);
  try
    Q.Connection := DataModuleConnection.FDConnectionMain;
    Q.SQL.Text :=
      'SELECT id, username ' +
      'FROM usuarios ' +
      'WHERE activo = TRUE AND empresa_id = :eid ' +
      'ORDER BY username';
    Q.ParamByName('eid').AsInteger := ACompanyId;
    Q.Open;

    while not Q.Eof do
    begin
      ATarget.AddObject(
        Q.FieldByName('username').AsString,
        TObject(NativeInt(Q.FieldByName('id').AsInteger))
      );
      Q.Next;
    end;
  finally
    Q.Free;
  end;
end;

class function TLoginManager.ValidateLogin(ACompanyId, AUserId: Integer;
  const APassword: string): Boolean;
var
  Q: TFDQuery;
  PassDB: string;
begin
  Result := False;

  if (ACompanyId = 0) or (AUserId = 0) then
    Exit;

  Q := TFDQuery.Create(nil);
  try
    Q.Connection := DataModuleConnection.FDConnectionMain;
    Q.SQL.Text :=
      'SELECT password ' +
      'FROM usuarios ' +
      'WHERE id = :uid AND empresa_id = :eid AND activo = TRUE';
    Q.ParamByName('uid').AsInteger := AUserId;
    Q.ParamByName('eid').AsInteger := ACompanyId;
    Q.Open;

    if Q.IsEmpty then
      Exit;

    PassDB := Q.Fields[0].AsString;

    if SameText(APassword, PassDB) then
    begin
      // Guardamos la sesión global
      AppSession.CompanyId := ACompanyId;
      AppSession.UserId := AUserId;

      // Información extendida (si lo necesitas más adelante)
      AppSession.CompanyName := '';
      AppSession.UserName := '';

      Result := True;
    end;
  finally
    Q.Free;
  end;
end;

end.

