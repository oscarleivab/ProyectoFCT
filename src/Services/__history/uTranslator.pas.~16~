unit uTranslator;

interface

uses
  System.SysUtils, System.Classes, System.IniFiles, System.IOUtils, Vcl.StdCtrls,uConfigIni;

type
  TTranslator = class
  private
    FIni: TMemIniFile;
    FLang: string;
    function LangFilePath(const Lang: string): string;
    procedure LoadLang(const Lang: string);
  public
    constructor Create(const Lang: string);
    destructor Destroy; override;

    // Devuelve el texto traducido: si no existe, devuelve Default o la clave
    function GetText(const Section, Key: string; const Default: string = ''): string;

    // Cambiar idioma en caliente
    procedure SetLanguage(const Lang: string);
    property Language: string read FLang;
  end;

{ API global simple }
function T_(const Section, Key: string): string; overload;
function T_(const Section, Key, Default: string): string; overload;
procedure UseLanguage(const Lang: string);
procedure LoadAvailableLanguages(ACombo: TComboBox);
function Translator: TTranslator;

// === Aplicar traducción al árbol de componentes (Form, Frame, DataModule, etc.) ===
procedure TranslateTree(Root: TComponent; const Section: string = '');

// === Utilidades para cambio de idioma en caliente (opcional) ===
procedure TranslateAllOpenUI;
procedure UseLanguageAndRefresh(const Lang: string);

// === Banderas de exclusión por Tag (útiles para combos llenados desde BBDD, etc.) ===
const
  NT_SKIP_ALL   = $1; // No traducir nada del control
  NT_SKIP_ITEMS = $2; // No traducir Items (listas)
  NT_SKIP_TEXT  = $4; // No traducir Text (valor seleccionado)

// Opcional: cambiar la ruta base de idiomas si no quieres la carpeta por defecto
var
  TranslationsBasePath: string = ''; // si está vacío: usa carpeta del EXE\idiomas\

implementation

uses
  System.TypInfo, System.Rtti,
  Vcl.Forms, Vcl.Controls, Vcl.ComCtrls, Vcl.Menus, Vcl.ActnList,
  Vcl.ExtCtrls, Vcl.DBCtrls;

var
  GTranslator: TTranslator;

{ TTranslator }

constructor TTranslator.Create(const Lang: string);
begin
  inherited Create;
  LoadLang(Lang);
end;

destructor TTranslator.Destroy;
begin
  FIni.Free;
  inherited;
end;

function TTranslator.LangFilePath(const Lang: string): string;
var
  base: string;
begin
  if TranslationsBasePath <> '' then
    base := TranslationsBasePath
  else
    base := TPath.Combine(ExtractFilePath(ParamStr(0)), 'idiomas');

  Result := TPath.Combine(base, Lang + '.ini');
end;

procedure TTranslator.LoadLang(const Lang: string);
var
  FileName: string;
begin
  FileName := LangFilePath(Lang);

  if not TFile.Exists(FileName) then
  begin
    // Fallback: si no existe, intenta 'Español'; si tampoco, lanza excepción clara
    if not SameText(Lang, 'Español') then
    begin
      FileName := LangFilePath('Español');
      if not TFile.Exists(FileName) then
        raise Exception.CreateFmt('No se encuentra el archivo de idioma: %s', [LangFilePath(Lang)]);
      FLang := 'Español';
    end
    else
      raise Exception.CreateFmt('No se encuentra el archivo de idioma: %s', [FileName]);
  end
  else
    FLang := Lang;

  FreeAndNil(FIni);
  // UTF-8 recomendado para archivos .ini de idiomas
  FIni := TMemIniFile.Create(FileName, TEncoding.UTF8);
end;

function TTranslator.GetText(const Section, Key, Default: string): string;
begin
  if Default <> '' then
    Result := FIni.ReadString(Section, Key, Default)
  else
    Result := FIni.ReadString(Section, Key, Key); // por defecto, devuelve la clave
end;

procedure TTranslator.SetLanguage(const Lang: string);
begin
  if not SameText(FLang, Lang) then
    LoadLang(Lang);
end;

{ API global }

function Translator: TTranslator;
begin
  if GTranslator = nil then
    GTranslator := TTranslator.Create('Español'); // idioma por defecto de arranque
  Result := GTranslator;
end;

procedure UseLanguage(const Lang: string);
begin
  Translator.SetLanguage(Lang);
end;

function T_(const Section, Key: string): string;
begin
  Result := Translator.GetText(Section, Key);
end;

function T_(const Section, Key, Default: string): string;
begin
  Result := Translator.GetText(Section, Key, Default);
end;

procedure LoadAvailableLanguages(ACombo: TComboBox);
var
  LangFolder, LangCode, LangName: string;
  Files: TArray<string>;
  F: string;
begin
  if ACombo = nil then
    Exit;

  ACombo.Items.BeginUpdate;
  try
    ACombo.Clear;

    // Carpeta de idiomas (por defecto junto al ejecutable)
    LangFolder := TPath.Combine(ExtractFilePath(ParamStr(0)), 'idiomas');
    if not TDirectory.Exists(LangFolder) then
      Exit;

    // Buscar todos los ficheros .ini dentro de /idiomas
    Files := TDirectory.GetFiles(LangFolder, '*.ini');
    for F in Files do
    begin
      // “en.ini” → “en”
      LangCode := TPath.GetFileNameWithoutExtension(F);
      LangName := LangCode;

      // Guarda el código en Objects (para uso posterior)
      ACombo.Items.AddObject(LangName, TObject(Pointer(StrNew(PChar(LangCode)))));
    end;

    {if ACombo.Items.Count > 0 then
      ACombo.ItemIndex := 0; }

    ACombo.Items.IndexOf(AppConfig.DefaultLang);

  finally
    ACombo.Items.EndUpdate;
  end;
end;

{ === Traducción visual === }

const
  _MISS = #1; // sentinela para detectar "no encontrado"

function ReadKey(const Section, CompKey, PropName: string): string;
begin
  Result := Translator.GetText(Section, CompKey + '.' + PropName, _MISS);
  if Result = _MISS then
    Result := ''; // tratar como no existente
end;

function ShouldSkipTranslate(C: TComponent): Boolean;
begin
  Result := (C is TControl) and ((TControl(C).Tag and NT_SKIP_ALL) <> 0);
end;

function ShouldSkipItems(C: TComponent): Boolean;
begin
  Result := (C is TControl) and ((TControl(C).Tag and NT_SKIP_ITEMS) <> 0);
end;

function ShouldSkipText(C: TComponent): Boolean;
begin
  Result := (C is TControl) and ((TControl(C).Tag and NT_SKIP_TEXT) <> 0);
end;

function IsDataAwareListControl(C: TComponent): Boolean;
begin
  Result :=
    (C is TDBComboBox) or
    (C is TDBLookupComboBox) or
    (C is TDBListBox) or
    (C is TDBLookupListBox);
end;

procedure SetPropIfExists(Comp: TObject; const PropName, Value: string);
var
  Ctx: TRttiContext;
  Typ: TRttiType;
  Prop: TRttiProperty;
begin
  if (Comp = nil) or (Value = '') then Exit;
  Ctx := TRttiContext.Create;
  try
    Typ := Ctx.GetType(Comp.ClassType);
    Prop := Typ.GetProperty(PropName);
    if (Prop <> nil) and Prop.IsWritable then
    begin
      case Prop.PropertyType.TypeKind of
        tkString, tkLString, tkWString, tkUString:
          Prop.SetValue(Comp, Value);
      else
        // si necesitas aceptar otros tipos string-like, añádelos aquí
      end;
    end;
  finally
    Ctx.Free;
  end;
end;

function KeyBase(C: TComponent): string;
begin
  if (C <> nil) and (C.Name <> '') then
    Result := C.Name
  else
    Result := C.ClassName;
end;

procedure TranslateOne(C: TComponent; const SectionName: string);
var
  K, V, Tmp: string;
  I: Integer;
begin
  if (C = nil) or ShouldSkipTranslate(C) then Exit;

  K := KeyBase(C);

  // 1) Actions primero (para que controles enlazados hereden)
  if C is TAction then
  begin
    V := ReadKey(SectionName, K, 'Caption'); if V <> '' then TAction(C).Caption := V;
    V := ReadKey(SectionName, K, 'Hint');    if V <> '' then TAction(C).Hint    := V;
    // opcional: otras props string mediante RTTI
    V := ReadKey(SectionName, K, 'ShortCutHint'); if V <> '' then SetPropIfExists(C, 'ShortCutHint', V);
    Exit;
  end;

  // 2) Menús (recursivo)
  if C is TMenuItem then
  begin
    // Si tiene Action, que la Action gestione Caption/Hint
    if TMenuItem(C).Action = nil then
    begin
      V := ReadKey(SectionName, K, 'Caption');
      if V <> '' then TMenuItem(C).Caption := V;
    end;

    for I := 0 to TMenuItem(C).Count - 1 do
      TranslateOne(TMenuItem(C).Items[I], SectionName);

    Exit;
  end;

  // 3) Controles enlazados a Action: no tocar Caption/Hint para no pisar
  if (C is TControl) and (TControl(C).Action <> nil) then
    Exit;

  // 4) Props comunes (Caption, Text, Hint) por RTTI
  V := ReadKey(SectionName, K, 'Caption'); if V <> '' then SetPropIfExists(C, 'Caption', V);
  V := ReadKey(SectionName, K, 'Text');    if V <> '' then SetPropIfExists(C, 'Text', V);
  V := ReadKey(SectionName, K, 'Hint');    if V <> '' then SetPropIfExists(C, 'Hint', V);

  // 5) Listas (Combo/List) — con exclusiones y data-aware
  if C is TCustomComboBox then
  begin
    if not IsDataAwareListControl(C) then
    begin
      if not ShouldSkipItems(C) then
      begin
        V := ReadKey(SectionName, K, 'Items');
        if V <> '' then
        begin
          // Convención: items separados por |
          Tmp := StringReplace(V, '|', sLineBreak, [rfReplaceAll]);
          TCustomComboBox(C).Items.Text := Tmp;
        end;
      end;

      if not ShouldSkipText(C) then
      begin
        V := ReadKey(SectionName, K, 'Text');
        if V <> '' then SetPropIfExists(C, 'Text', V);
      end;
    end;

    Exit;
  end
  else if C is TCustomListBox then
  begin
    if not ShouldSkipItems(C) then
    begin
      V := ReadKey(SectionName, K, 'Items');
      if V <> '' then
      begin
        Tmp := StringReplace(V, '|', sLineBreak, [rfReplaceAll]);
        TCustomListBox(C).Items.Text := Tmp;
      end;
    end;
    Exit;
  end;

  // 6) RadioGroup: items indexados
  if C is TRadioGroup then
  begin
    for I := 0 to TRadioGroup(C).Items.Count - 1 do
    begin
      V := Translator.GetText(SectionName, K + '.Items[' + I.ToString + ']', _MISS);
      if V <> _MISS then
        TRadioGroup(C).Items[I] := V;
    end;
    Exit;
  end;

  // 7) PageControl: pestañas por índice
  if C is TPageControl then
  begin
    for I := 0 to TPageControl(C).PageCount - 1 do
    begin
      V := Translator.GetText(SectionName, K + '.Tabs[' + I.ToString + ']', _MISS);
      if V <> _MISS then
        TPageControl(C).Pages[I].Caption := V;
    end;
    Exit;
  end;
end;

procedure RecurseComponent(C: TComponent; const SectionName: string);
var
  I: Integer;
  WC: TWinControl;
begin
  if C = nil then Exit;

  // Traducir el propio componente
  TranslateOne(C, SectionName);

  // Recorrer hijos visuales (TWinControl.Controls[])
  if C is TWinControl then
  begin
    WC := TWinControl(C);
    for I := 0 to WC.ControlCount - 1 do
      if WC.Controls[I] is TComponent then
        RecurseComponent(TComponent(WC.Controls[I]), SectionName);
  end;

  // Recorrer componentes "owned" (no visuales y visuales no parentados aún)
  for I := 0 to C.ComponentCount - 1 do
    RecurseComponent(C.Components[I], SectionName);
end;

procedure TranslateTree(Root: TComponent; const Section: string = '');
var
  SectionName: string;
begin
  if Root = nil then Exit;

  if Section <> '' then
    SectionName := Section
  else if (Root.Name <> '') then
    SectionName := Root.Name
  else
    SectionName := Root.ClassName;

  RecurseComponent(Root, SectionName);

  // Menú principal del formulario (por si acaso)
  if (Root is TCustomForm) and (TCustomForm(Root).Menu <> nil) then
    if TCustomForm(Root).Menu.Items <> nil then
      RecurseComponent(TCustomForm(Root).Menu.Items, SectionName);
end;

procedure TranslateAllOpenUI;
var
  I: Integer;
begin
  // DataModules primero (Actions, etc.)
  for I := 0 to Screen.DataModuleCount - 1 do
    TranslateTree(Screen.DataModules[I]);

  // Formularios después (labels, captions, menús…)
  for I := 0 to Screen.FormCount - 1 do
    TranslateTree(Screen.Forms[I]);
end;

procedure UseLanguageAndRefresh(const Lang: string);
begin
  UseLanguage(Lang);
  TranslateAllOpenUI;
end;

initialization
  // opcional: fija aquí TranslationsBasePath si quieres una ruta personalizada
  // TranslationsBasePath := TPath.Combine(ExtractFilePath(ParamStr(0)), 'idiomas');

finalization
  FreeAndNil(GTranslator);

end.

