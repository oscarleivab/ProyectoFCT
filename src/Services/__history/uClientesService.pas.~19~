class function TClientesService.Cargarlistado(filtro: string): TObjectList<TCliente>;
var
  Q: TFDQuery;
  C: TCliente;
  TieneFiltro: Boolean;
begin
  Result := TObjectList<TCliente>.Create(True); // OwnsObjects = True

  Q := crearquery(nil);
  try
    TieneFiltro := not filtro.Trim.IsEmpty;

    Q.SQL.Clear;
    Q.SQL.Add('SELECT ');
    Q.SQL.Add('  id_cliente,');
    Q.SQL.Add('  id_tipo,');
    Q.SQL.Add('  id_tipo_documento,');
    Q.SQL.Add('  detalle_documento,');
    Q.SQL.Add('  nombre,');
    Q.SQL.Add('  apellidos,');
    Q.SQL.Add('  empresa,');
    Q.SQL.Add('  email,');
    Q.SQL.Add('  observaciones,');
    Q.SQL.Add('  telefono1,');
    Q.SQL.Add('  telefono2,');
    Q.SQL.Add('  id_tarifa,');
    Q.SQL.Add('  persona_contacto,');
    Q.SQL.Add('  url_web,');
    Q.SQL.Add('  user_login,');
    Q.SQL.Add('  pass_login,');
    Q.SQL.Add('  activo,');
    Q.SQL.Add('  id_permiso');
    Q.SQL.Add('FROM cliente');

    if TieneFiltro then
    begin
      Q.SQL.Add('WHERE (');
      Q.SQL.Add('      unaccent(CAST(id_cliente AS TEXT)) ILIKE unaccent(:filtro)');
      Q.SQL.Add('   OR unaccent(detalle_documento) ILIKE unaccent(:filtro)');
      Q.SQL.Add('   OR unaccent(nombre) ILIKE unaccent(:filtro)');
      Q.SQL.Add('   OR unaccent(apellidos) ILIKE unaccent(:filtro)');
      Q.SQL.Add('   OR unaccent(nombre || '' '' || apellidos) ILIKE unaccent(:filtro)');
      Q.SQL.Add('   OR unaccent(apellidos || '' '' || nombre) ILIKE unaccent(:filtro)');
      Q.SQL.Add('   OR unaccent(empresa) ILIKE unaccent(:filtro)');
      Q.SQL.Add('   OR unaccent(email) ILIKE unaccent(:filtro)');
      Q.SQL.Add('   OR unaccent(observaciones) ILIKE unaccent(:filtro)');
      Q.SQL.Add('   OR unaccent(telefono1) ILIKE unaccent(:filtro)');
      Q.SQL.Add('   OR unaccent(telefono2) ILIKE unaccent(:filtro)');
      Q.SQL.Add('   OR unaccent(persona_contacto) ILIKE unaccent(:filtro)');
      Q.SQL.Add(')');
    end;

    Q.SQL.Add('ORDER BY id_cliente');

    if TieneFiltro then
      Q.ParamByName('filtro').AsString := '%' + filtro.Trim + '%';

    try
      Q.Open;
    except
      on E: Exception do
        raise Exception.Create('Error cargando clientes: ' + E.Message);
    end;

    while not Q.Eof do
    begin
      C := TCliente.Create;
      C.IdCliente        := Q.FieldByName('id_cliente').AsInteger;
      C.IdTipo           := Q.FieldByName('id_tipo').AsInteger;
      C.IdTipoDocumento  := Q.FieldByName('id_tipo_documento').AsInteger;
      C.DetalleDocumento := Q.FieldByName('detalle_documento').AsString;
      C.Nombre           := Q.FieldByName('nombre').AsString;
      C.Apellidos        := Q.FieldByName('apellidos').AsString;
      C.Empresa          := Q.FieldByName('empresa').AsString;
      C.Email            := Q.FieldByName('email').AsString;
      C.Observaciones    := Q.FieldByName('observaciones').AsString;
      C.Telefono1        := Q.FieldByName('telefono1').AsString;
      C.Telefono2        := Q.FieldByName('telefono2').AsString;
      C.IdTarifa         := Q.FieldByName('id_tarifa').AsInteger;
      C.PersonaContacto  := Q.FieldByName('persona_contacto').AsString;
      C.UrlWeb           := Q.FieldByName('url_web').AsString;
      C.UserLogin        := Q.FieldByName('user_login').AsString;
      C.PassLogin        := Q.FieldByName('pass_login').AsString;
      C.Activo           := Q.FieldByName('activo').AsBoolean;
      C.IdPermiso        := Q.FieldByName('id_permiso').AsInteger;

      Result.Add(C);
      Q.Next;
    end;
  finally
    Q.Free;
  end;
end;


