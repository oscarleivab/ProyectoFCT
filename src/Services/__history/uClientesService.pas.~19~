class function TClientesService.GrabarDatos(Cliente: TCliente): boolean;
var
  Q: TFDQuery;
  EsUpdate: Boolean;
begin
  Result := False;

  if Cliente = nil then
    Exit;

  Q := crearquery(nil);
  try
    EsUpdate := Cliente.IdCliente <> 0;

    Q.SQL.Clear;

    if EsUpdate then
    begin
      Q.SQL.Add('UPDATE cliente SET ');
      Q.SQL.Add('  id_tipo = :id_tipo,');
      Q.SQL.Add('  id_tipo_documento = :id_tipo_documento,');
      Q.SQL.Add('  detalle_documento = :detalle_documento,');
      Q.SQL.Add('  nombre = :nombre,');
      Q.SQL.Add('  apellidos = :apellidos,');
      Q.SQL.Add('  empresa = :empresa,');
      Q.SQL.Add('  email = :email,');
      Q.SQL.Add('  observaciones = :observaciones,');
      Q.SQL.Add('  telefono1 = :telefono1,');
      Q.SQL.Add('  telefono2 = :telefono2,');
      Q.SQL.Add('  id_tarifa = :id_tarifa,');
      Q.SQL.Add('  persona_contacto = :persona_contacto,');
      Q.SQL.Add('  url_web = :url_web,');
      Q.SQL.Add('  user_login = :user_login,');
      Q.SQL.Add('  pass_login = :pass_login,');
      Q.SQL.Add('  activo = :activo,');
      Q.SQL.Add('  id_permiso = :id_permiso');
      Q.SQL.Add('WHERE id_cliente = :id_cliente');
    end
    else
    begin
      Q.SQL.Add('INSERT INTO cliente (');
      Q.SQL.Add('  id_tipo, id_tipo_documento, detalle_documento,');
      Q.SQL.Add('  nombre, apellidos, empresa, email, observaciones,');
      Q.SQL.Add('  telefono1, telefono2, id_tarifa, persona_contacto,');
      Q.SQL.Add('  url_web, user_login, pass_login, activo, id_permiso');
      Q.SQL.Add(') VALUES (');
      Q.SQL.Add('  :id_tipo, :id_tipo_documento, :detalle_documento,');
      Q.SQL.Add('  :nombre, :apellidos, :empresa, :email, :observaciones,');
      Q.SQL.Add('  :telefono1, :telefono2, :id_tarifa, :persona_contacto,');
      Q.SQL.Add('  :url_web, :user_login, :pass_login, :activo, :id_permiso');
      Q.SQL.Add(') RETURNING id_cliente');
    end;

    // ---- parámetros comunes ----
    Q.ParamByName('id_tipo').AsInteger := Cliente.IdTipo;
    Q.ParamByName('id_tipo_documento').AsInteger := Cliente.IdTipoDocumento;
    Q.ParamByName('detalle_documento').AsString := Cliente.DetalleDocumento;
    Q.ParamByName('nombre').AsString := Cliente.Nombre;
    Q.ParamByName('apellidos').AsString := Cliente.Apellidos;
    Q.ParamByName('empresa').AsString := Cliente.Empresa;
    Q.ParamByName('email').AsString := Cliente.Email;
    Q.ParamByName('observaciones').AsString := Cliente.Observaciones;
    Q.ParamByName('telefono1').AsString := Cliente.Telefono1;
    Q.ParamByName('telefono2').AsString := Cliente.Telefono2;
    Q.ParamByName('id_tarifa').AsInteger := Cliente.IdTarifa;
    Q.ParamByName('persona_contacto').AsString := Cliente.PersonaContacto;
    Q.ParamByName('url_web').AsString := Cliente.UrlWeb;
    Q.ParamByName('user_login').AsString := Cliente.UserLogin;
    Q.ParamByName('pass_login').AsString := Cliente.PassLogin;
    Q.ParamByName('activo').AsBoolean := Cliente.Activo;
    Q.ParamByName('id_permiso').AsInteger := Cliente.IdPermiso;

    if EsUpdate then
      Q.ParamByName('id_cliente').AsInteger := Cliente.IdCliente;

    try
      if EsUpdate then
      begin
        Q.ExecSQL;
        Result := Q.RowsAffected > 0;
      end
      else
      begin
        Q.Open;
        if not Q.IsEmpty then
        begin
          Cliente.IdCliente := Q.Fields[0].AsInteger;
          Result := True;
        end;
      end;
    except
      on E: Exception do
        raise Exception.Create('Error grabando cliente: ' + E.Message);
    end;

  finally
    Q.Free;
  end;
end;



end.
