unit uDatabaselib;

interface

uses
  Winapi.Windows, Winapi.Messages, System.SysUtils, System.Variants, System.Classes, Vcl.Graphics,
  Vcl.Controls, Vcl.Forms, Vcl.Dialogs, Vcl.StdCtrls, Vcl.WinXPickers,
  FireDAC.Stan.Intf, FireDAC.Stan.Option, FireDAC.Stan.Error, FireDAC.UI.Intf,
  FireDAC.Phys.Intf, FireDAC.Stan.Def, FireDAC.Stan.Pool, FireDAC.Stan.Async,
  FireDAC.Phys, FireDAC.Phys.PG, FireDAC.Phys.PGDef, FireDAC.VCLUI.Wait,
  Data.DB, FireDAC.Comp.Client,uConfigIni,usession,dmConnection;

  procedure CerrarConexion;
  function CrearTransaccion: TFDTransaction;
  function CrearQuery(TR:TFDTransaction;SQL: string = ''): TFDQuery;
  procedure DestruirTransaccion(TR: TFDTransaction);
  procedure DestruirQuery(qGenerica: TFDQuery);

implementation


procedure DestruirTransaccion(TR: TFDTransaction);
begin
  if Assigned(TR) then
    FreeAndNil(TR);
end;

procedure DestruirQuery(qGenerica: TFDQuery);
begin
  if Assigned(qGenerica) then
  begin
    if qGenerica.Active then
      qGenerica.Close;
    FreeAndNil(qGenerica);
  end;
end;

function ComprobarConexion: Boolean;
begin
  try
    Result := Assigned(DataModuleConnection.FDConnectionCompany) and DataModuleConnection.FDConnectionCompany.Connected;
    if not Result then
    begin
      DataModuleConnection.FDConnectionCompany.Close;
      Result := DataModuleConnection.FDConnectionCompany.Connected;
    end;
  except
    Result := False;
  end;
end;

function CrearTransaccion: TFDTransaction;
begin
  Result := TFDTransaction.Create(nil);
  try
    Result.Connection := DataModuleConnection.FDConnectionCompany;
    Result.Options.ReadOnly:=false;
    Result.Options.Isolation := xiReadCommitted;
  except
    if Assigned(Result) then
      FreeAndNil(Result);
  end;
end;

function CrearQuery(TR:TFDTransaction;SQL: string = ''): TFDQuery;
begin
  Result := TFDQuery.Create(nil);
  try
    Result.Connection := DataModuleConnection.FDConnectionCompany;
    Result.Transaction := TR;
    Result.SQL.Text:= SQL;
  except
    if Assigned(Result) then
      FreeAndNil(Result);
  end;
end;


end.
